# Optional. You can also enter keys in the app (Settings), which stores them in data/settings.json.
# Environment variables take effect when no key is saved in the app.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Where papers, the SQLite database, settings and ChatGPT tokens are stored (default: ./data)
# PAPER_READER_DATA=./data

# Sign in with ChatGPT in Docker: publish this port and bind to all interfaces inside the container.
# PAPER_READER_OAUTH_PORT=1455
# PAPER_READER_OAUTH_BIND=0.0.0.0
